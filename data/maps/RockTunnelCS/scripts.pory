mapscripts RockTunnelCS_MapScripts {

}

script RockTunnelCS_Script_TestRock {
    special (DoPeccadumTruckScene)
}

script RockTunnelCS_EventScript_RivalTrigger1 {
	lockall	
	applymovement (OBJ_EVENT_ID_PLAYER, Common_Movement_ExclamationMark)
	waitmovement (0)
	applymovement (2, Common_Movement_FaceRight)
	waitmovement (0)
	load_field_pic (4, 190, 98)
	msgbox (RockTunnelCS_Text_Leaf1)
	closemessage
	destroy_field_pic (4)
	applymovement (OBJ_EVENT_ID_PLAYER, Common_Movement_FaceRight)
	waitmovement (0)
	addobject (3)
	showobjectat (3, MAP_ROCK_TUNNEL_CS)
	applymovement (3, RockTunnelCS_Movement_RivalEntrance1)
	waitmovement (0)
	load_field_pic (3, 190, 98)
	msgbox (RockTunnelCS_Text_RivalIntro)
	destroy_field_pic (3)
	closemessage
	trainerbattle_no_intro(TRAINER_RIVAL3, RockTunnelCS_Text_RivalLost)
	load_field_pic (3, 190, 98)
	msgbox (RockTunnelCS_Text_RivalPost)
	destroy_field_pic (3)
	closemessage
	applymovement (3, RockTunnelCS_Movement_RivalExit)
	waitmovement (0)
	removeobject (3)
	applymovement (2, RockTunnelCS_Movement_LeafApproach1)
	applymovement (OBJ_EVENT_ID_PLAYER, Common_Movement_FaceLeft)
	waitmovement (0)
	load_field_pic (4, 190, 98)
	msgbox (RockTunnelCS_Text_Leaf2)
	closemessage
	destroy_field_pic (4)
	applymovement (2, RockTunnelCS_Movement_LeafExit)
	waitmovement (0)
	removeobject (2)
	setflag (FLAG_ROCKTUNNEL_RIVALDEFEATED)
	setvar (VAR_ROBUSTUS_STATE, 9)
	releaseall
	end
}

script RockTunnelCS_EventScript_RivalTrigger2 {
	lockall	
	applymovement (OBJ_EVENT_ID_PLAYER, Common_Movement_ExclamationMark)
	waitmovement (0)
	applymovement (2, Common_Movement_FaceRight)
	waitmovement (0)
	load_field_pic (4, 190, 98)
	msgbox (RockTunnelCS_Text_Leaf1)
	closemessage
	destroy_field_pic (4)
	applymovement (OBJ_EVENT_ID_PLAYER, Common_Movement_FaceRight)
	waitmovement (0)
	addobject (3)
	showobjectat (3, MAP_ROCK_TUNNEL_CS)
	applymovement (3, RockTunnelCS_Movement_RivalEntrance2)
	waitmovement (0)
	load_field_pic (3, 190, 98)
	msgbox (RockTunnelCS_Text_RivalIntro)
	destroy_field_pic (3)
	closemessage
	trainerbattle_no_intro(TRAINER_RIVAL3, RockTunnelCS_Text_RivalLost)
	load_field_pic (3, 190, 98)
	msgbox (RockTunnelCS_Text_RivalPost)
	destroy_field_pic (3)
	closemessage
	applymovement (3, RockTunnelCS_Movement_RivalExit)
	waitmovement (0)
	removeobject (3)
	applymovement (2, RockTunnelCS_Movement_LeafApproach2)
	applymovement (OBJ_EVENT_ID_PLAYER, Common_Movement_FaceLeft)
	waitmovement (0)
	load_field_pic (4, 190, 98)
	msgbox (RockTunnelCS_Text_Leaf2)
	closemessage
	destroy_field_pic (4)
	applymovement (2, RockTunnelCS_Movement_LeafExit)
	waitmovement (0)
	removeobject (2)
	setflag (FLAG_ROCKTUNNEL_RIVALDEFEATED)
	setvar (VAR_ROBUSTUS_STATE, 9)
