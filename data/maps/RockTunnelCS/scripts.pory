	end
}


movement RockTunnelCS_Movement_RivalEntrance1 {
	walk_left * 8
}

movement RockTunnelCS_Movement_RivalEntrance2 {
	walk_diag_southwest
	walk_left * 7
}

movement RockTunnelCS_Movement_RivalExit {
	walk_right * 8
}

movement RockTunnelCS_Movement_LeafApproach1 {
	walk_right * 3
}

movement RockTunnelCS_Movement_LeafApproach2 {
	walk_diag_southeast
	walk_right * 2
}

movement RockTunnelCS_Movement_LeafExit {
	walk_left * 8
}


text RockTunnelCS_Text_Leaf1 {
	format("Watch out! I think we fell into a trap!")
}

text RockTunnelCS_Text_RivalIntro {
	format("I've been waiting for you some time now {PLAYER} while you were still too weak to break those rocks I was mastering the art of battle. I will destroy you here once and for all.")
}

text RockTunnelCS_Text_RivalLost {
	format("It can't be so! I was superior!")
}

text RockTunnelCS_Text_RivalPost {
	format("You are the very worst man on this earth. I curse you every day and won't forget the torment that you've brought into my life! Do not imagine that this is the end.")
}

text RockTunnelCS_Text_Leaf2 {
	format("My hero {PLAYER} you saved me once again! C'mon! We need to push through to the end.")
}


